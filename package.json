{
  "name": "my-sous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-images.ts",
    "placeholder": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-placeholder.ts",
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run images && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-storybook.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "gray-matter": "^4.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "serve": "^14.2.6",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
