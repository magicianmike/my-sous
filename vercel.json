{
  "headers": [
    {
      "source": "/case-study/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/storybook/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/storybook/iframe.html",
      "destination": "/storybook/iframe"
    }
  ]
}
